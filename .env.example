# Salin menjadi .env.local (untuk laptop) atau isi di Vercel → Settings → Environment Variables.
# JANGAN commit .env.local ke GitHub.

# URL backend Langflow, tanpa garis miring di akhir.
# Saat ini: URL Cloudflare Tunnel dari online.bat (berubah setiap tunnel dinyalakan ulang).
LANGFLOW_URL=https://xxxx.trycloudflare.com

# API key Langflow (Settings → Langflow API Keys). Hanya dipakai di server, tidak dikirim ke browser.
LANGFLOW_API_KEY=

# Opsional: URL Web App Google Apps Script untuk menyimpan laporan "jawaban keliru" ke Google Sheets.
# Kosongkan jika belum ada; laporan hanya dicatat di log server.
REPORT_WEBHOOK_URL=
