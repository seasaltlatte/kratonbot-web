# Salin menjadi .env.local (untuk laptop) atau isi di Vercel → Settings → Environment Variables.
# JANGAN commit .env.local ke GitHub.

# Wajib. API key Gemini dari Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Opsional. Model Gemini utama; jika kosong dipakai gemini-3.5-flash-lite, lalu gemini-flash-latest sebagai cadangan.
GEMINI_MODEL=

# Opsional. API key Composio untuk mengirim undangan Google Calendar dari akun Google kelompok.
# Jika kosong atau gagal, KratonBot memberi tautan "Tambahkan ke Google Calendar" sebagai gantinya.
COMPOSIO_API_KEY=
# Opsional. User ID Composio yang terhubung ke Google Calendar (bawaan: default).
COMPOSIO_USER_ID=
# Opsional. ID akun Google Calendar yang aktif di Composio (Connected Accounts), misalnya ca_xxxx.
# Isi jika user default punya lebih dari satu akun.
COMPOSIO_CONNECTED_ACCOUNT_ID=

# Opsional: URL Web App Google Apps Script untuk menyimpan laporan "jawaban keliru" ke Google Sheets.
# Kosongkan jika belum ada; laporan hanya dicatat di log server.
REPORT_WEBHOOK_URL=
